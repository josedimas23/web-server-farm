FROM nginx:latest

# Crear directorio para SSL
RUN mkdir -p /etc/nginx/ssl

# Copiar certificados SSL al contenedor
COPY P4-josedimasugr-certificados/certificado_josedimasugr.crt /etc/nginx/ssl/certificado_josedimasugr.crt
COPY P4-josedimasugr-certificados/certificado_josedimasugr.key /etc/nginx/ssl/certificado_josedimasugr.key

# Incluir configuración de Nginx para SSL
COPY P4-josedimasugr-nginx/josedimasugr-nginx-ssl.conf /etc/nginx/nginx.conf

# Exponer el puerto HTTPS
EXPOSE 443 80

CMD ["nginx", "-g", "daemon off;"]
