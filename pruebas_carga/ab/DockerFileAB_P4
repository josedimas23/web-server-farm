#Imagen del entorno
FROM debian:latest

#Quien la creo
LABEL maintainer="josedimas23"

#Evita preguntas para la instalacion
ENV DEBIAN_FRONTEND=noninteractive

#Instalar lo necesario
RUN apt-get update && apt-get install apache2 php libapache2-mod-php curl -y

#variable de entorno con la URL del servidor
ENV SERVER_URL=https://localhost:8089/

#Comando que se ejecutara al iniciar el contenedor
CMD ["ab", "-n", "10000", "-c", "100", "$SERVER_URL"]

